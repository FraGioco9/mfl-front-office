{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": false
  },
  "include": [
    "app.js",
    "modules/app-entry.js",
    "modules/http.js",
    "modules/release.js",
    "modules/runtime-loader.js",
    "types/**/*.d.ts"
  ]
}
