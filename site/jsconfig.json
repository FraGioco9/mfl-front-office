{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [],
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": false
  },
  "include": [
    "bootstrap.js",
    "modules/app-entry.js",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
