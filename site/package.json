{
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build:core": "node build-app-core.mjs",
    "build": "npm run build:core",
    "prelint": "node sidebar-lifecycle-migration.mjs apply",
    "lint": "eslint bootstrap.js bootstrap-core.js build-app-core.mjs modules api/releases.js api/mfl-season-ratios-v2.js *-runtime.js validate*.mjs",
    "typecheck": "tsc -p jsconfig.json --noEmit",
    "verify:generated": "git diff --exit-code -- table-width-runtime.js",
    "validate": "node validate-all.mjs",
    "postvalidate": "node sidebar-lifecycle-migration.mjs publish",
    "check": "npm run lint && npm run typecheck && npm run build:core && npm run verify:generated && npm run validate"
  },
  "dependencies": {
    "@onflow/fcl": "1.21.11"
  },
  "devDependencies": {
    "@actions/artifact": "^2.2.2",
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "typescript": "^5.0.0"
  }
}
