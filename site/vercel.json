{
  "functions": {
    "api/data.js": {
      "includeFiles": "api/data-files/**"
    },
    "api/summary.js": {
      "includeFiles": "api/data-files/manifest.json"
    }
  },
  "headers": [
    {
      "source": "/app.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/app-core.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/app-fixes.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/home",
      "destination": "/"
    },
    {
      "source": "/database",
      "destination": "/"
    },
    {
      "source": "/database/:view",
      "destination": "/"
    },
    {
      "source": "/mfl",
      "destination": "/"
    },
    {
      "source": "/mfl/:view",
      "destination": "/"
    },
    {
      "source": "/progression",
      "destination": "/"
    },
    {
      "source": "/progression/:view",
      "destination": "/"
    },
    {
      "source": "/watchlist",
      "destination": "/"
    },
    {
      "source": "/watchlist/:id",
      "destination": "/"
    },
    {
      "source": "/watchlist/:id/:view",
      "destination": "/"
    },
    {
      "source": "/my-players",
      "destination": "/"
    },
    {
      "source": "/my-players/:view",
      "destination": "/"
    },
    {
      "source": "/evaluation",
      "destination": "/"
    },
    {
      "source": "/settings",
      "destination": "/"
    },
    {
      "source": "/changelog",
      "destination": "/"
    },
    {
      "source": "/players",
      "destination": "/"
    },
    {
      "source": "/players/:id",
      "destination": "/"
    },
    {
      "source": "/agents",
      "destination": "/"
    },
    {
      "source": "/agents/:wallet",
      "destination": "/"
    },
    {
      "source": "/agents/:wallet/:view",
      "destination": "/"
    }
  ],
  "ignoreCommand": "node vercel-ignore-git-deploy.js"
}
