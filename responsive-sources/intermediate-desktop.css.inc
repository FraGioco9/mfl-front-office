@media (min-width: 901px) and (max-width: 1444px) {
  .topbar h1 {
    overflow: visible;
    text-overflow: clip;
  }

  .stats div {
    width: 116px;
    min-width: 116px;
    height: 42px;
    padding: 4px 18px;
  }

  .stats > div > span {
    overflow: visible;
    text-overflow: clip;
    line-height: 1;
  }

  .stats label {
    margin-top: 0;
    line-height: 1;
  }

  #progressionPage .playerTableScroller th.selectionCell {
    padding-inline: 0;
    text-align: center;
    text-overflow: clip;
  }
}

@media (min-width: 901px) and (max-width: 1366px) {
  .playerPage .playerHero {
    padding-bottom: 4px;
  }
}
