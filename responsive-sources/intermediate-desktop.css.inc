@media (min-width: 901px) and (max-width: 1366px) {
  #progressionPage #tableHead .rowActionsCell {
    overflow: hidden;
  }

  #progressionPage #tableHead .rowActionsCell > * {
    display: none;
  }

  #progressionPage #tableHead .rowActionsCell::before,
  #progressionPage #tableHead .rowActionsCell::after {
    content: none;
    display: none;
  }

  .playerPage .playerHero {
    padding-bottom: 4px;
  }
}
