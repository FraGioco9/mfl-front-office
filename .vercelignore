# Repository/CI files are not part of the production Vercel artifact.
.github
.gitignore
supabase
README.md
*.py
supabase-schema.sql

# Site development, validation, and deployment configuration assets.
site/validate*.mjs
site/eslint.config.mjs
site/jsconfig.json
site/types
site/vercel.production.json

# Application-core compiler sources are build-only. Production serves the generated
# shared core and route runtime artifacts created before Vercel packaging.
site/build-app-core.mjs
site/sync-release-projections.mjs
site/modules/app-config.js
site/modules/pre-bootstrap-route-state.js
site/modules/package.json
site/modules/core-sources
