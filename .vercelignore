# Repository/CI files are not part of the production Vercel artifact.
.github
.gitignore
supabase
README.md
*.py
supabase-schema.sql

# Site development, validation, and deployment configuration assets.
local-dev-server.mjs
validate*.mjs
validation-text.mjs
ci-quality-scope.mjs
eslint.config.mjs
jsconfig.json
types
vercel.production.json

# Site compiler sources are build-only. Production serves generated application-core
# runtimes, generated Vercel config, and the bundled primary stylesheet.
build-app-core.mjs
build-styles.mjs
style-bundle.mjs
build-vercel-config.mjs
vercel-config-source.mjs
sync-release-projections.mjs
modules/app-config.js
modules/core-source-manifest.js
modules/pre-bootstrap-route-state.js
modules/package.json
modules/core-sources

html-sources
responsive-sources
build-fragments.mjs
build-html.mjs
build-responsive.mjs
validation
scripts
tests
docs
